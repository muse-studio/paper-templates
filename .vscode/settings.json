{
  "latex-workshop.latex.recipes": [
    {
      "name": "pLaTeX + pBibTeX + dvipdfmx",
      "tools": ["latexmk-platex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-platex",
      "command": "latexmk",
      "args": [
        "-e", "$latex='platex %O -synctex=1 -interaction=nonstopmode -file-line-error %S'",
        "-e", "$bibtex='pbibtex %O %B'",
        "-e", "$dvipdf='dvipdfmx %O -o %D %S'",
        "-norc",
        "-pdfdvi",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first"
}
